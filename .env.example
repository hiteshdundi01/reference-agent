# Copy to .env and fill in. The checks never read .env.

# The model the agent works on, as "provider:model" for LangChain's
# init_chat_model, and the provider's key. A cheaper model is a one-line change,
# such as anthropic:claude-haiku-5-5 or openai:<model>.
AGENT_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=
# Only for an Anthropic key that isn't scoped to a workspace: the workspace to use.
# ANTHROPIC_WORKSPACE_ID=

# The agent's key, which the backend and the agent share. Make one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_KEY=

# Signs people's sign-in tokens. Make one the same way.
AUTH_SECRET=

# The password every seeded rep and supervisor signs in with.
USER_PASSWORD=

# Optional: where things are, when not the defaults.
# APP_DB=app.db
# CHECKPOINT_DB=checkpoints.db
# AGENT_URL=http://127.0.0.1:8080
# APP_API=http://127.0.0.1:8000
